{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "paths": {
      "@blocknote/core": ["./src/types/blocknote-core.d.ts"],
      "@blocknote/core/extensions": ["./src/types/blocknote-core-extensions.d.ts"],
      "@blocknote/mantine": ["./src/types/blocknote-mantine.d.ts"],
      "@blocknote/react": ["./src/types/blocknote-react.d.ts"],
      "pdfjs-dist/legacy/build/pdf.mjs": ["./src/types/pdfjs-legacy.d.ts"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
