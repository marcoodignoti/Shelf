{
  "name": "opennotion",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first Notion-style workspace.",
  "author": "Marco Dignoti",
  "license": "MIT",
  "homepage": "https://github.com/marcoodignoti/OpenNotion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcoodignoti/OpenNotion.git"
  },
  "bugs": {
    "url": "https://github.com/marcoodignoti/OpenNotion/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "e2e:install": "playwright install chromium",
    "e2e": "npm run build && playwright test",
    "perf": "npm run perf:frontend",
    "perf:frontend": "playwright test --config playwright.perf.config.ts --reporter=list",
    "perf:native": "bash perf/profile-macos.sh",
    "check": "npm run check:electron",
    "check:electron": "npm run build && npm run test && npm run electron:smoke && npm run electron:smoke:runtime && npm audit --audit-level=moderate && npm run electron:package:dir && npm run electron:smoke:visual && npm run electron:smoke:parity && npm run electron:smoke:stability",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm run dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:1420 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:1420 electron .\"",
    "electron:smoke": "node electron/smoke.cjs",
    "electron:smoke:runtime": "cross-env ELECTRON_RUN_AS_NODE=1 electron electron/smoke.cjs",
    "electron:smoke:visual": "node electron/visual-smoke.cjs",
    "electron:smoke:parity": "node electron/parity-smoke.cjs",
    "electron:smoke:stability": "node electron/stability-smoke.cjs",
    "electron:clean": "node -e \"require('node:fs').rmSync('dist-electron', { recursive: true, force: true })\"",
    "electron:package:dir": "npm run build && node scripts/electron-package-dir.cjs",
    "electron:package:dmg": "npm run electron:package:dir && node scripts/electron-package-dmg.cjs",
    "electron:package:win": "npm run build && node scripts/electron-package-win.cjs",
    "electron:build": "npm run electron:package:dmg",
    "release:package:electron": "npm run electron:package:dmg",
    "release:package:desktop": "npm run electron:package:dmg",
    "release:package:macos": "npm run electron:package:dmg",
    "release:package:windows": "npm run electron:package:win",
    "release:verify:macos": "node scripts/electron-verify-macos.cjs"
  },
  "dependencies": {
    "@blocknote/core": "0.51.0",
    "@blocknote/mantine": "0.51.0",
    "@blocknote/react": "0.51.0",
    "@mantine/core": "9.2.1",
    "@mantine/hooks": "9.2.1",
    "clsx": "2.1.1",
    "katex": "0.17.0",
    "lucide-react": "1.16.0",
    "pdfjs-dist": "5.7.284",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/use-sync-external-store": "^1.5.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^40.10.2",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "prosemirror-model": "1.25.4"
  }
}
