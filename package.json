{
  "name": "shelf",
  "private": true,
  "version": "0.5.0",
  "description": "Local-first workspace for notes, documents, and study.",
  "author": "Marco Dignoti",
  "license": "MIT",
  "homepage": "https://github.com/marcoodignoti/Shelf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcoodignoti/Shelf.git"
  },
  "bugs": {
    "url": "https://github.com/marcoodignoti/Shelf/issues"
  },
  "type": "module",
  "workspaces": ["packages/*"],
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "cross-env UV_THREADPOOL_SIZE=64 npm run build:app",
    "build:app": "tsc && vite build",
    "test": "cross-env UV_THREADPOOL_SIZE=64 vitest run",
    "test:coverage": "cross-env UV_THREADPOOL_SIZE=64 vitest run --coverage",
    "e2e:install": "playwright install chromium",
    "e2e": "npm run build && playwright test",
    "screenshots:readme": "npm run build && node scripts/capture-readme-screenshots.mjs",
    "perf": "npm run perf:frontend",
    "perf:frontend": "playwright test --config playwright.perf.config.ts --reporter=list",
    "perf:native": "bash perf/profile-macos.sh",
    "check": "npm run check:electron",
    "check:electron": "npm run build && npm run test && npm run test:scripts && npm run electron:smoke && npm run electron:smoke:runtime && npm audit --audit-level=moderate && npm run electron:package:dir && npm run electron:smoke:visual && npm run electron:smoke:parity && npm run electron:smoke:stability",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "node scripts/electron-dev.cjs",
    "electron:smoke": "node electron/smoke.cjs",
    "electron:smoke:runtime": "cross-env ELECTRON_RUN_AS_NODE=1 electron electron/smoke.cjs",
    "electron:smoke:visual": "node electron/visual-smoke.cjs",
    "electron:smoke:parity": "node electron/parity-smoke.cjs",
    "electron:smoke:stability": "node electron/stability-smoke.cjs",
    "electron:clean": "node -e \"require('node:fs').rmSync('dist-electron', { recursive: true, force: true })\"",
    "electron:package:dir": "npm run electron:clean && npm run build && node scripts/electron-package-dir.cjs",
    "electron:package:dmg": "npm run electron:package:dir && node scripts/electron-package-dmg.cjs",
    "electron:package:win": "npm run electron:clean && npm run build && node scripts/electron-package-win.cjs",
    "electron:package:win:installer": "npm run electron:clean && npm run build && electron-builder --win nsis --x64 --publish never",
    "electron:build": "npm run electron:package:dmg",
    "release:package:electron": "npm run electron:package:dmg",
    "release:package:desktop": "npm run electron:package:dmg",
    "release:package:macos": "npm run electron:package:dmg",
    "release:package:windows": "npm run electron:package:win",
    "release:package:windows:installer": "npm run electron:package:win:installer",
    "release:update-keypair": "node scripts/generate-update-keypair.cjs",
    "release:update-manifest": "node scripts/write-beta-update-manifest.cjs",
    "release:update-manifest:compat": "node scripts/write-beta-compat-manifest.cjs",
    "release:verify:macos": "node scripts/electron-verify-macos.cjs",
    "release:checksums": "node scripts/write-release-checksums.cjs",
    "test:scripts": "node --test scripts/*.test.cjs electron/*.test.cjs"
  },
  "build": {
    "appId": "com.marcodignoti.shelf",
    "productName": "Shelf",
    "directories": {
      "output": "dist-electron/builder"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json",
      "!**/.shelf-dev",
      "!**/.opennotion-dev",
      "!**/.secrets",
      "!**/*.db",
      "!**/*.sqlite",
      "!**/*.sqlite3",
      "!**/*.pem.local",
      "!**/.DS_Store"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "marcoodignoti",
        "repo": "Shelf"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icon.ico",
      "artifactName": "Shelf_${version}_setup_win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@blocknote/core": "0.51.4",
    "@blocknote/mantine": "0.51.4",
    "@blocknote/react": "0.51.4",
    "@mantine/core": "9.3.2",
    "@mantine/hooks": "9.3.2",
    "katex": "0.17.0",
    "lucide-react": "1.21.0",
    "pdfjs-dist": "6.0.227",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vitest": "4.1.9"
  },
  "overrides": {
    "prosemirror-model": "1.25.4",
    "undici": "7.28.0"
  }
}
